# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8010

# Auth / JWT (must match main Appointment-Setter backend token settings)
SECRET_KEY=replace_me
JWT_ALGORITHM=HS256

# Firebase (same project as main platform)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Redis (shared if using existing LiveKit worker compatibility)
REDIS_URL=redis://localhost:6379/0
CALL_CONFIG_TTL_SECONDS=3600

# Twilio / LiveKit
TWILIO_WEBHOOK_BASE_URL=http://localhost:8010
LIVEKIT_SIP_DOMAIN=
LIVEKIT_SIP_HEADER_TENANT_ID=X-LK-TenantId
LIVEKIT_SIP_HEADER_CALL_ID=X-LK-CallId
LIVEKIT_SIP_HEADER_CALLED_NUMBER=X-LK-CalledNumber

# AWS S3 (intro audio uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
PRESIGNED_URL_EXPIRES_SECONDS=900
MAX_AUDIO_UPLOAD_MB=10

